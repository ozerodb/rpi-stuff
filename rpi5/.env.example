# --- Paths ---
APPDATA=/opt/appdata    # app-internal state (postgres, ntfy, adguardhome, etc.)
STORAGE=/opt/storage    # user files: calibre library, paperless documents (access via SFTP)

# --- Paperless-ngx ---
PAPERLESS_SECRET_KEY=
PAPERLESS_ADMIN_PASSWORD=

# --- Postgres (used by Paperless) ---
POSTGRES_PASSWORD=
