# /etc/rpi-backup.env — read by rpi-backup.service (root-only, mode 600).
# Installed by utils/backup/install.sh; fill in and then: sudo systemctl enable --now rpi-backup.timer

# --- restic repository (pick one backend) ---
# Backblaze B2 / any S3-compatible bucket:
RESTIC_REPOSITORY=s3:https://s3.eu-central-003.backblazeb2.com/<bucket>/rpi5
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Or SFTP to your Mac / another box (key in /root/.ssh):
#RESTIC_REPOSITORY=sftp:user@host.TAILNET.ts.net:/backups/rpi5

# Encryption password — losing it means losing the backups. Store a copy in your password manager.
RESTIC_PASSWORD=

# --- What to back up (defaults match rpi5/.env.example) ---
APPDATA=/opt/appdata
STORAGE=/opt/storage

# --- Retention ---
RESTIC_FORGET_ARGS=--keep-daily 7 --keep-weekly 4 --keep-monthly 6

# --- Alerting (optional) ---
# ntfy on rpizero2; token = NTFY_PUBLISH_TOKEN from rpizero2/.env
NTFY_URL=https://rpizero2.TAILNET.ts.net:2586/alerts
NTFY_TOKEN=
# Dead-man's switch, e.g. https://hc-ping.com/<uuid> — alerts if a backup never reports in
HC_PING_URL=
