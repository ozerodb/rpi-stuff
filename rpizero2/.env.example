# rpizero2/.env — rendered by: python3 utils/firstboot/prepare_firstboot.py --board rpizero2 --tailnet <tailnet> --env-only
# Keep values single-quoted where shown: bcrypt hashes contain '$', which Compose would otherwise interpolate.
TAILNET=
NTFY_AUTH_USERS='reader:<bcrypt-hash>:user,publisher:<bcrypt-hash>:user'
NTFY_AUTH_TOKENS='publisher:tk_<29 lowercase alphanumerics>:gatus and scripts'
NTFY_PUBLISH_TOKEN=tk_<same token as above>
